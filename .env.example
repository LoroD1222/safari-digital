# Required: create a Supabase project, run the SQL migration, then add its server credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=

# Required for the protected inquiry dashboard at /admin.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required for team notification emails. Customer confirmations are optional.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SAFARI_DIGITAL_INQUIRY_EMAIL=
SEND_CUSTOMER_CONFIRMATION=false

# Public production origin used in confirmation links.
SITE_URL=https://www.safaridigital.co.tz
